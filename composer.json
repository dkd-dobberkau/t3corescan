{
    "name": "t3x/t3corescan",
    "type": "typo3-cms-extension",
    "description": "CLI command exposing the TYPO3 Extension Scanner of EXT:install. Internal core classes are intentionally used; bound to the installed Core version.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-install": "^13.4 || ^14.3",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^7.0",
        "symfony/finder": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "typo3/testing-framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "T3x\\T3Corescan\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "T3x\\T3Corescan\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "t3corescan",
            "version": "0.1.0",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
